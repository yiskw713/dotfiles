[user]
    email = i.yuchi713@gmail.com
    name = yiskw713

[init]
    defaultBranch = main

[core]
    # delta が無い環境 (mise install 前など) では less にフォールバックする
    pager = "if command -v delta >/dev/null 2>&1; then delta; else less; fi"
    editor = vim

[interactive]
    diffFilter = "if command -v delta >/dev/null 2>&1; then delta --color-only; else cat; fi"

[delta]
    navigate = true

[merge]
    conflictstyle = zdiff3

[pull]
    rebase = true

[fetch]
    prune = true

[push]
    autoSetupRemote = true

[diff]
    colorMoved = default

[ghq]
    root = ~/work

[alias]
    tree = "log --graph --date=iso --pretty='[%ad]%C(auto) %h%d %Cgreen%an%Creset : %s'"
