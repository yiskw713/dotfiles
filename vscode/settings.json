{
    "editor.renderControlCharacters": true, // 制御文字を表示する
    "files.insertFinalNewline": true, // ファイルの末尾を改行で終わらせる
    "editor.bracketPairColorization.enabled": true, // 括弧の対応を色付ける
    "workbench.startupEditor": "newUntitledFile",
    // pythonの環境設定
    "files.watcherExclude": {
        "**/venv/**": true
    },
    "python.analysis.extraPaths": [
        "./src"
    ],
    "[python]": {
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        },
        "editor.formatOnPaste": false,
        "editor.formatOnSaveMode": "file",
        "editor.formatOnType": true,
    },
    "editor.formatOnPaste": true,
    "autoDocstring.docstringFormat": "google",
    "editor.fontSize": 14,
    "editor.minimap.enabled": false,
    // editor.wordSeparators: 単語単位での移動を行う場合の区切り文字を指定
    // 日本語文書で単語移動を使うため、助詞や読点、括弧を区切り文字として指定する
    "editor.wordSeparators": "./\\()\"'-:,.;<>~!@#$%^&*|+=[]{}`~?　、。「」【】『』（）！？てにをはがのともへでや",
    "editor.acceptSuggestionOnCommitCharacter": false,
    "editor.acceptSuggestionOnEnter": "off",
    // liveserver
    "liveServer.settings.donotVerifyTags": true,
    // for presentation mode
    "presentationMode.zoomLevel": 2,
    "zenMode.centerLayout": false,
    "hediet.vscode-drawio.offline": false,
    "todo-tree.highlights.customHighlight": {
        "TODO": {
            "icon": "check",
            "type": "line",
            "iconColour": "yellow",
            "foreground": "red",
            "background": "yellow"
        },
        "FIXME": {
            "icon": "beaker",
            "iconColour": "red",
            "foreground": "white",
            "background": "red"
        }
    },
    "workbench.editorAssociations": {
        "*.ipynb": "jupyter-notebook"
    },
    "python.languageServer": "Pylance",
    "todo-tree.general.tags": [
        "BUG",
        "HACK",
        "FIXME",
        "TODO",
        "XXX",
        "[ ]",
        "[x]"
    ],
    "todo-tree.regex.regex": "(//|#|<!--|;|/\\*|^|^\\s*(-|\\d+.))\\s*($TAGS)",
    "footsteps.doHighlightChanges": false,
    "editor.fontFamily": "\"HackGen35 Console NF\", Menlo, Monaco, 'Courier New', monospace",
    "editor.ruler": [
        88
    ],
    "workbench.colorCustomizations": {
        "editor.lineHighlightBackground": "#272626",
        "editorRuler.foreground": "#ff4081"
    },
    "notebook.cellToolbarLocation": {
        "default": "right",
        "jupyter-notebook": "left"
    },
    // rust
    "[rust]": {
        "editor.defaultFormatter": "rust-lang.rust-analyzer",
        "editor.formatOnSave": true,
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
    },
    "http.systemCertificates": false,
    "docwriter.style": "Google",
    "zenMode.hideLineNumbers": false,
    // 行数を相対表示
    "editor.lineNumbers": "relative",
    // カギ括弧をカラー表示
    "editor.guides.bracketPairs": true,
    "editor.accessibilitySupport": "off",
    "terminal.integrated.enableMultiLinePasteWarning": false,
    "[dockerfile]": {
        "editor.defaultFormatter": "ms-azuretools.vscode-docker"
    },
    "redhat.telemetry.enabled": false,
    "rust-analyzer.checkOnSave.command": "clippy",
    "explorer.confirmDelete": false,
    "window.zoomLevel": -1,
    "editor.inlineSuggest.enabled": true,
    "editor.formatOnSave": true,
    "yaml.disableSchemaDetection": [
        "**/.github/workflows/*.yml",
        "**/.github/workflows/*.yaml",
        "**/.gitea/workflows/*.yml",
        "**/.gitea/workflows/*.yaml",
        "**/.forgejo/workflows/*.yml",
        "**/.forgejo/workflows/*.yaml"
    ],
}
